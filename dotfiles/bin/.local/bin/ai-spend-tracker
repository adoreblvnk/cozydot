#!/usr/bin/env python3
"""Estimate AI PAYG spend from local Hermes and OpenCode usage.

Pricing is fetched from https://models.dev/api.json. Cost fields are treated as
USD per 1M tokens. Cache tokens use cache pricing when available, otherwise
fall back to input pricing.
"""

from __future__ import annotations

import argparse
import json
import math
import os
import sqlite3
import sys
import time
import urllib.request
from dataclasses import dataclass
from datetime import date, datetime, time as dt_time, timedelta
from pathlib import Path
from typing import Any

MODELS_DEV_API = "https://models.dev/api.json"


def user_cache_dir() -> Path:
    """Return the platform-appropriate user cache directory."""
    if xdg_cache := os.environ.get("XDG_CACHE_HOME"):
        return Path(xdg_cache).expanduser()
    if sys.platform == "darwin":
        return Path.home() / "Library" / "Caches"
    return Path.home() / ".cache"


def user_data_dir() -> Path:
    """Return the platform-appropriate user data directory."""
    if xdg_data := os.environ.get("XDG_DATA_HOME"):
        return Path(xdg_data).expanduser()
    if sys.platform == "darwin":
        return Path.home() / "Library" / "Application Support"
    return Path.home() / ".local" / "share"


def first_existing(paths: list[Path]) -> Path:
    """Pick the first existing path, falling back to the platform default."""
    expanded = [p.expanduser() for p in paths]
    for path in expanded:
        if path.exists():
            return path
    return expanded[0]


def default_hermes_db() -> Path:
    if env_path := os.environ.get("HERMES_DB"):
        return Path(env_path).expanduser()
    return Path.home() / ".hermes" / "state.db"


def default_opencode_db() -> Path:
    if env_path := os.environ.get("OPENCODE_DB"):
        return Path(env_path).expanduser()

    platform_default = user_data_dir() / "opencode" / "opencode.db"
    linux_default = Path.home() / ".local" / "share" / "opencode" / "opencode.db"
    macos_default = Path.home() / "Library" / "Application Support" / "opencode" / "opencode.db"
    return first_existing([platform_default, linux_default, macos_default])


def default_claude_dir() -> Path:
    if env_path := os.environ.get("CLAUDE_CONFIG_DIR"):
        return Path(env_path).expanduser()
    return Path.home() / ".claude"


DEFAULT_HERMES_DB = default_hermes_db()
DEFAULT_OPENCODE_DB = default_opencode_db()
DEFAULT_CLAUDE_DIR = default_claude_dir()
DEFAULT_CACHE = user_cache_dir() / "ai-spend-tracker" / "models.dev.api.json"

# Map local tool/provider names to models.dev provider keys.
PROVIDER_ALIASES = {
    "openai-codex": "openai",
    "chatgpt": "openai",
    "openai-chatgpt": "openai",
    "copilot": "github-copilot",
    "copilot-cli": "github-copilot",
    "github-copilot": "github-copilot",
    "google": "google",
    "gemini": "google",
    "anthropic": "anthropic",
    "claude-code": "anthropic",
}

MODEL_ALIASES: dict[str, str] = {}


@dataclass
class UsageRow:
    source: str
    model: str
    billing_provider: str | None
    sessions: int
    calls: int
    input_tokens: int
    output_tokens: int
    cache_read_tokens: int
    cache_write_tokens: int
    reasoning_tokens: int
    day: str | None = None


def fetch_json(url: str, cache_path: Path, max_cache_age_hours: float = 24, refresh: bool = False) -> dict[str, Any]:
    cache_path.parent.mkdir(parents=True, exist_ok=True)
    if not refresh and cache_path.exists():
        age_hours = (time.time() - cache_path.stat().st_mtime) / 3600
        if age_hours <= max_cache_age_hours:
            return json.loads(cache_path.read_text())

    req = urllib.request.Request(url, headers={"User-Agent": "ai-spend-tracker/1.0"})
    with urllib.request.urlopen(req, timeout=30) as resp:
        data = json.load(resp)
    cache_path.write_text(json.dumps(data, indent=2, sort_keys=True))
    return data


def normalize_pricing_provider(provider: str | None) -> str | None:
    if not provider:
        return None
    p = provider.lower()
    return PROVIDER_ALIASES.get(p, p)


def candidate_model_ids(model: str, provider: str) -> list[str]:
    m = MODEL_ALIASES.get(model, model)
    lab_prefixes = ["openai/", "anthropic/", "google/", "xai/", "moonshotai/", "deepseek/"]
    stripped = m
    for prefix in lab_prefixes:
        if stripped.startswith(prefix):
            stripped = stripped[len(prefix) :]
            break

    candidates = [m, stripped]
    if provider == "openrouter" and "/" not in stripped:
        candidates.append(f"openai/{stripped}")
    if provider == "openai" and stripped.startswith("openai/"):
        candidates.append(stripped.split("/", 1)[1])

    out: list[str] = []
    for c in candidates:
        if c and c not in out:
            out.append(c)
    return out


def find_model(provider_data: dict[str, Any], provider: str, model: str) -> tuple[str | None, dict[str, Any] | None]:
    models = provider_data.get(provider, {}).get("models", {})
    for mid in candidate_model_ids(model, provider):
        if mid in models:
            return mid, models[mid]

    want = model.lower()
    for mid, meta in models.items():
        if want == mid.lower() or want == str(meta.get("name", "")).lower():
            return mid, meta
    return None, None


def pick_cost(cost: dict[str, Any]) -> tuple[dict[str, float], str]:
    """Return prices, using the model's first context tier when present."""
    tiers = cost.get("tiers")
    if isinstance(tiers, list):
        for tier in tiers:
            tier_meta = tier.get("tier") if isinstance(tier, dict) else None
            if isinstance(tier_meta, dict) and tier_meta.get("type") == "context":
                prices = dict(cost)
                prices.update(tier)
                size = tier_meta.get("size")
                numeric = {k: float(v) for k, v in prices.items() if isinstance(v, (int, float))}
                return numeric, f"context>{fmt_int(size) if isinstance(size, int) else size}"
    return {k: float(v) for k, v in cost.items() if isinstance(v, (int, float))}, "standard"


def money(tokens: int, price_per_million: float | None) -> float:
    return 0.0 if not price_per_million else tokens * price_per_million / 1_000_000


def query_hermes_usage(db_path: Path, days: int, model_like: str | None) -> list[UsageRow]:
    if not db_path.exists():
        return []

    cutoff = time.time() - days * 86400
    where = ["started_at >= ?", "model IS NOT NULL", "(input_tokens + output_tokens + cache_read_tokens + cache_write_tokens) > 0"]
    params: list[Any] = [cutoff]
    if model_like:
        where.append("model LIKE ?")
        params.append(f"%{model_like}%")

    sql = f"""
        SELECT
            model,
            billing_provider,
            COUNT(*) AS sessions,
            COALESCE(SUM(api_call_count), 0) AS calls,
            COALESCE(SUM(input_tokens), 0) AS input_tokens,
            COALESCE(SUM(output_tokens), 0) AS output_tokens,
            COALESCE(SUM(cache_read_tokens), 0) AS cache_read_tokens,
            COALESCE(SUM(cache_write_tokens), 0) AS cache_write_tokens,
            COALESCE(SUM(reasoning_tokens), 0) AS reasoning_tokens
        FROM sessions
        WHERE {' AND '.join(where)}
        GROUP BY model, billing_provider
    """
    conn = sqlite3.connect(db_path)
    try:
        rows = conn.execute(sql, params).fetchall()
    finally:
        conn.close()
    return [UsageRow("hermes", *r) for r in rows]


def query_hermes_daily_usage(db_path: Path, start_ts: float, model_like: str | None) -> list[UsageRow]:
    if not db_path.exists():
        return []

    where = ["started_at >= ?", "model IS NOT NULL", "(input_tokens + output_tokens + cache_read_tokens + cache_write_tokens) > 0"]
    params: list[Any] = [start_ts]
    if model_like:
        where.append("model LIKE ?")
        params.append(f"%{model_like}%")

    sql = f"""
        SELECT
            date(started_at, 'unixepoch', 'localtime') AS day,
            model,
            billing_provider,
            COUNT(*) AS sessions,
            COALESCE(SUM(api_call_count), 0) AS calls,
            COALESCE(SUM(input_tokens), 0) AS input_tokens,
            COALESCE(SUM(output_tokens), 0) AS output_tokens,
            COALESCE(SUM(cache_read_tokens), 0) AS cache_read_tokens,
            COALESCE(SUM(cache_write_tokens), 0) AS cache_write_tokens,
            COALESCE(SUM(reasoning_tokens), 0) AS reasoning_tokens
        FROM sessions
        WHERE {' AND '.join(where)}
        GROUP BY day, model, billing_provider
    """
    conn = sqlite3.connect(db_path)
    try:
        rows = conn.execute(sql, params).fetchall()
    finally:
        conn.close()

    return [
        UsageRow(
            source="hermes",
            model=model,
            billing_provider=billing_provider,
            sessions=int(sessions),
            calls=int(calls),
            input_tokens=int(input_tokens),
            output_tokens=int(output_tokens),
            cache_read_tokens=int(cache_read_tokens),
            cache_write_tokens=int(cache_write_tokens),
            reasoning_tokens=int(reasoning_tokens),
            day=day,
        )
        for day, model, billing_provider, sessions, calls, input_tokens, output_tokens, cache_read_tokens, cache_write_tokens, reasoning_tokens in rows
    ]


def parse_opencode_model(raw: str | None) -> tuple[str | None, str | None]:
    if not raw:
        return None, None
    try:
        data = json.loads(raw)
    except json.JSONDecodeError:
        return None, raw
    return data.get("providerID"), data.get("id") or data.get("modelID")


def to_int(value: Any) -> int:
    if isinstance(value, bool) or value is None:
        return 0
    if isinstance(value, (int, float)):
        return int(value)
    try:
        return int(value)
    except (TypeError, ValueError):
        return 0


def parse_timestamp(value: Any) -> float | None:
    if isinstance(value, (int, float)):
        # Claude Code JSONL may use epoch seconds or milliseconds.
        return float(value) / 1000 if value > 10_000_000_000 else float(value)
    if not isinstance(value, str) or not value:
        return None
    try:
        text = value.replace("Z", "+00:00")
        return datetime.fromisoformat(text).timestamp()
    except ValueError:
        return None


def local_midnight(day: date) -> float:
    return datetime.combine(day, dt_time.min).timestamp()


def date_range(start: date, end: date) -> list[date]:
    days = (end - start).days
    return [start + timedelta(days=i) for i in range(days + 1)]


def query_opencode_usage(db_path: Path, days: int, model_like: str | None) -> list[UsageRow]:
    if not db_path.exists():
        return []

    cutoff_ms = int((time.time() - days * 86400) * 1000)
    sql = """
        SELECT
            model,
            COUNT(*) AS sessions,
            COALESCE(SUM(tokens_input), 0) AS input_tokens,
            COALESCE(SUM(tokens_output), 0) AS output_tokens,
            COALESCE(SUM(tokens_cache_read), 0) AS cache_read_tokens,
            COALESCE(SUM(tokens_cache_write), 0) AS cache_write_tokens,
            COALESCE(SUM(tokens_reasoning), 0) AS reasoning_tokens
        FROM session
        WHERE time_created >= ?
          AND model IS NOT NULL
          AND (tokens_input + tokens_output + tokens_cache_read + tokens_cache_write) > 0
        GROUP BY model
    """
    conn = sqlite3.connect(f"file:{db_path}?mode=ro", uri=True)
    try:
        raw_rows = conn.execute(sql, (cutoff_ms,)).fetchall()
    finally:
        conn.close()

    merged: dict[tuple[str | None, str], UsageRow] = {}
    for raw_model, sessions, input_t, output_t, cache_read_t, cache_write_t, reasoning_t in raw_rows:
        provider, model = parse_opencode_model(raw_model)
        if not model:
            continue
        if model_like and model_like.lower() not in model.lower():
            continue
        key = (provider, model)
        existing = merged.get(key)
        if existing is None:
            merged[key] = UsageRow(
                source="opencode",
                model=model,
                billing_provider=provider,
                sessions=int(sessions),
                calls=0,
                input_tokens=int(input_t),
                output_tokens=int(output_t),
                cache_read_tokens=int(cache_read_t),
                cache_write_tokens=int(cache_write_t),
                reasoning_tokens=int(reasoning_t),
            )
        else:
            existing.sessions += int(sessions)
            existing.input_tokens += int(input_t)
            existing.output_tokens += int(output_t)
            existing.cache_read_tokens += int(cache_read_t)
            existing.cache_write_tokens += int(cache_write_t)
            existing.reasoning_tokens += int(reasoning_t)
    return list(merged.values())


def query_opencode_daily_usage(db_path: Path, start_ts: float, model_like: str | None) -> list[UsageRow]:
    if not db_path.exists():
        return []

    cutoff_ms = int(start_ts * 1000)
    sql = """
        SELECT
            date(time_created / 1000, 'unixepoch', 'localtime') AS day,
            model,
            COUNT(*) AS sessions,
            COALESCE(SUM(tokens_input), 0) AS input_tokens,
            COALESCE(SUM(tokens_output), 0) AS output_tokens,
            COALESCE(SUM(tokens_cache_read), 0) AS cache_read_tokens,
            COALESCE(SUM(tokens_cache_write), 0) AS cache_write_tokens,
            COALESCE(SUM(tokens_reasoning), 0) AS reasoning_tokens
        FROM session
        WHERE time_created >= ?
          AND model IS NOT NULL
          AND (tokens_input + tokens_output + tokens_cache_read + tokens_cache_write) > 0
        GROUP BY day, model
    """
    conn = sqlite3.connect(f"file:{db_path}?mode=ro", uri=True)
    try:
        raw_rows = conn.execute(sql, (cutoff_ms,)).fetchall()
    finally:
        conn.close()

    merged: dict[tuple[str, str | None, str], UsageRow] = {}
    for day, raw_model, sessions, input_t, output_t, cache_read_t, cache_write_t, reasoning_t in raw_rows:
        provider, model = parse_opencode_model(raw_model)
        if not model:
            continue
        if model_like and model_like.lower() not in model.lower():
            continue
        key = (day, provider, model)
        existing = merged.get(key)
        if existing is None:
            merged[key] = UsageRow(
                source="opencode",
                model=model,
                billing_provider=provider,
                sessions=int(sessions),
                calls=0,
                input_tokens=int(input_t),
                output_tokens=int(output_t),
                cache_read_tokens=int(cache_read_t),
                cache_write_tokens=int(cache_write_t),
                reasoning_tokens=int(reasoning_t),
                day=day,
            )
        else:
            existing.sessions += int(sessions)
            existing.input_tokens += int(input_t)
            existing.output_tokens += int(output_t)
            existing.cache_read_tokens += int(cache_read_t)
            existing.cache_write_tokens += int(cache_write_t)
            existing.reasoning_tokens += int(reasoning_t)
    return list(merged.values())


def iter_claude_jsonl_files(claude_dir: Path) -> list[Path]:
    if not claude_dir.exists():
        return []

    roots = [claude_dir / "projects", claude_dir]
    files: list[Path] = []
    seen: set[Path] = set()
    for root in roots:
        if not root.exists():
            continue
        for path in root.rglob("*.jsonl"):
            resolved = path.resolve()
            if resolved not in seen:
                seen.add(resolved)
                files.append(path)
    return files


def query_claude_code_usage(claude_dir: Path, days: int, model_like: str | None) -> list[UsageRow]:
    """Parse Claude Code JSONL transcripts under ~/.claude/projects."""
    cutoff = time.time() - days * 86400
    merged: dict[str, UsageRow] = {}
    sessions_by_model: dict[str, set[str]] = {}

    for path in iter_claude_jsonl_files(claude_dir.expanduser()):
        try:
            file_mtime = path.stat().st_mtime
        except OSError:
            continue
        if file_mtime < cutoff:
            continue

        try:
            lines = path.read_text(errors="replace").splitlines()
        except OSError:
            continue

        session_key = str(path)
        for line in lines:
            if not line.strip():
                continue
            try:
                event = json.loads(line)
            except json.JSONDecodeError:
                continue
            if not isinstance(event, dict):
                continue

            event_ts = parse_timestamp(event.get("timestamp") or event.get("created_at") or event.get("time"))
            if event_ts is not None and event_ts < cutoff:
                continue

            message = event.get("message") if isinstance(event.get("message"), dict) else event
            usage = message.get("usage") if isinstance(message.get("usage"), dict) else event.get("usage")
            if not isinstance(usage, dict):
                continue

            model = message.get("model") or event.get("model")
            if not isinstance(model, str) or not model:
                continue
            if model_like and model_like.lower() not in model.lower():
                continue

            input_tokens = to_int(usage.get("input_tokens"))
            output_tokens = to_int(usage.get("output_tokens"))
            cache_read_tokens = to_int(usage.get("cache_read_input_tokens")) + to_int(usage.get("cache_read_tokens"))
            cache_write_tokens = (
                to_int(usage.get("cache_creation_input_tokens"))
                + to_int(usage.get("cache_creation_tokens"))
                + to_int(usage.get("cache_creation_ephemeral_5m_input_tokens"))
                + to_int(usage.get("cache_creation_ephemeral_1h_input_tokens"))
            )
            reasoning_tokens = to_int(usage.get("thinking_tokens")) + to_int(usage.get("reasoning_tokens"))

            if input_tokens + output_tokens + cache_read_tokens + cache_write_tokens + reasoning_tokens <= 0:
                continue

            existing = merged.get(model)
            if existing is None:
                existing = UsageRow(
                    source="claude-code",
                    model=model,
                    billing_provider="anthropic",
                    sessions=0,
                    calls=0,
                    input_tokens=0,
                    output_tokens=0,
                    cache_read_tokens=0,
                    cache_write_tokens=0,
                    reasoning_tokens=0,
                )
                merged[model] = existing
                sessions_by_model[model] = set()

            sessions_by_model[model].add(session_key)
            existing.calls += 1
            existing.input_tokens += input_tokens
            existing.output_tokens += output_tokens
            existing.cache_read_tokens += cache_read_tokens
            existing.cache_write_tokens += cache_write_tokens
            existing.reasoning_tokens += reasoning_tokens

    for model, row in merged.items():
        row.sessions = len(sessions_by_model.get(model, set()))
    return list(merged.values())


def query_claude_code_daily_usage(claude_dir: Path, start_ts: float, model_like: str | None) -> list[UsageRow]:
    """Parse Claude Code JSONL transcripts into local calendar-day buckets."""
    merged: dict[tuple[str, str], UsageRow] = {}
    sessions_by_key: dict[tuple[str, str], set[str]] = {}

    for path in iter_claude_jsonl_files(claude_dir.expanduser()):
        try:
            file_mtime = path.stat().st_mtime
        except OSError:
            continue
        if file_mtime < start_ts:
            continue

        try:
            lines = path.read_text(errors="replace").splitlines()
        except OSError:
            continue

        session_key = str(path)
        for line in lines:
            if not line.strip():
                continue
            try:
                event = json.loads(line)
            except json.JSONDecodeError:
                continue
            if not isinstance(event, dict):
                continue

            event_ts = parse_timestamp(event.get("timestamp") or event.get("created_at") or event.get("time"))
            if event_ts is None:
                event_ts = file_mtime
            if event_ts < start_ts:
                continue

            message = event.get("message") if isinstance(event.get("message"), dict) else event
            usage = message.get("usage") if isinstance(message.get("usage"), dict) else event.get("usage")
            if not isinstance(usage, dict):
                continue

            model = message.get("model") or event.get("model")
            if not isinstance(model, str) or not model:
                continue
            if model_like and model_like.lower() not in model.lower():
                continue

            input_tokens = to_int(usage.get("input_tokens"))
            output_tokens = to_int(usage.get("output_tokens"))
            cache_read_tokens = to_int(usage.get("cache_read_input_tokens")) + to_int(usage.get("cache_read_tokens"))
            cache_write_tokens = (
                to_int(usage.get("cache_creation_input_tokens"))
                + to_int(usage.get("cache_creation_tokens"))
                + to_int(usage.get("cache_creation_ephemeral_5m_input_tokens"))
                + to_int(usage.get("cache_creation_ephemeral_1h_input_tokens"))
            )
            reasoning_tokens = to_int(usage.get("thinking_tokens")) + to_int(usage.get("reasoning_tokens"))

            if input_tokens + output_tokens + cache_read_tokens + cache_write_tokens + reasoning_tokens <= 0:
                continue

            day = datetime.fromtimestamp(event_ts).date().isoformat()
            key = (day, model)
            existing = merged.get(key)
            if existing is None:
                existing = UsageRow(
                    source="claude-code",
                    model=model,
                    billing_provider="anthropic",
                    sessions=0,
                    calls=0,
                    input_tokens=0,
                    output_tokens=0,
                    cache_read_tokens=0,
                    cache_write_tokens=0,
                    reasoning_tokens=0,
                    day=day,
                )
                merged[key] = existing
                sessions_by_key[key] = set()

            sessions_by_key[key].add(session_key)
            existing.calls += 1
            existing.input_tokens += input_tokens
            existing.output_tokens += output_tokens
            existing.cache_read_tokens += cache_read_tokens
            existing.cache_write_tokens += cache_write_tokens
            existing.reasoning_tokens += reasoning_tokens

    for key, row in merged.items():
        row.sessions = len(sessions_by_key.get(key, set()))
    return list(merged.values())


def estimate(rows: list[UsageRow], provider_data: dict[str, Any], no_cache: bool = False) -> dict[str, Any]:
    results = []
    missing = []
    totals = {
        "sessions": 0,
        "calls": 0,
        "input_tokens": 0,
        "output_tokens": 0,
        "cache_read_tokens": 0,
        "cache_write_tokens": 0,
        "reasoning_tokens": 0,
        "cost_usd": 0.0,
    }
    by_source: dict[str, dict[str, float | int]] = {}

    for row in rows:
        for k in ["sessions", "calls", "input_tokens", "output_tokens", "cache_read_tokens", "cache_write_tokens", "reasoning_tokens"]:
            totals[k] += int(getattr(row, k))
        src = by_source.setdefault(row.source, {"cost_usd": 0.0, "sessions": 0})
        src["sessions"] = int(src["sessions"]) + row.sessions

        provider = normalize_pricing_provider(row.billing_provider)
        base = {
            "source": row.source,
            "model": row.model,
            "billing_provider": row.billing_provider,
            "pricing_provider": provider,
            "sessions": row.sessions,
            "calls": row.calls,
            "input_tokens": row.input_tokens,
            "output_tokens": row.output_tokens,
            "cache_read_tokens": row.cache_read_tokens,
            "cache_write_tokens": row.cache_write_tokens,
            "reasoning_tokens": row.reasoning_tokens,
        }
        if row.day is not None:
            base["day"] = row.day
        if not provider:
            missing.append({**base, "priced_as": None})
            results.append({**base, "priced_as": None, "cost_usd": None, "price_tier": None})
            continue

        found_id, meta = find_model(provider_data, provider, row.model)
        if not meta or not isinstance(meta.get("cost"), dict):
            missing.append({**base, "priced_as": None})
            results.append({**base, "priced_as": None, "cost_usd": None, "price_tier": None})
            continue

        prices, price_tier = pick_cost(meta["cost"])
        input_price = prices.get("input")
        cost_input = money(row.input_tokens, input_price)
        cost_output = money(row.output_tokens, prices.get("output"))
        cache_read_price = input_price if no_cache else prices.get("cache_read", input_price)
        cache_write_price = input_price if no_cache else prices.get("cache_write", input_price)
        cost_cache_read = money(row.cache_read_tokens, cache_read_price)
        cost_cache_write = money(row.cache_write_tokens, cache_write_price)
        cost_total = cost_input + cost_output + cost_cache_read + cost_cache_write
        cache_pricing = "input" if no_cache else "cache"
        cache_read_priced_as = "input" if no_cache or "cache_read" not in prices else "cache_read"
        cache_write_priced_as = "input" if no_cache or "cache_write" not in prices else "cache_write"
        totals["cost_usd"] += cost_total
        src["cost_usd"] = float(src["cost_usd"]) + cost_total

        results.append({
            **base,
            "pricing_provider": provider,
            "priced_as": found_id,
            "cost_usd": cost_total,
            "cost_breakdown_usd": {"input": cost_input, "output": cost_output, "cache_read": cost_cache_read, "cache_write": cost_cache_write},
            "cache_pricing": cache_pricing,
            "cache_read_priced_as": cache_read_priced_as,
            "cache_write_priced_as": cache_write_priced_as,
            "price_tier": price_tier,
        })

    results.sort(key=lambda x: float("inf") if x["cost_usd"] is None else -float(x["cost_usd"]))
    return {"totals": totals, "by_source": by_source, "by_model": results, "missing_prices": missing}


def fmt_int(n: int) -> str:
    return f"{n:,}"


def fmt_tokens(n: int) -> str:
    if n >= 1_000_000_000:
        return f"{n / 1_000_000_000:.2f}B"
    if n >= 1_000_000:
        return f"{n / 1_000_000:.1f}M"
    if n >= 1_000:
        return f"{n / 1_000:.1f}K"
    return str(n)


def color(text: str, code: str, enabled: bool) -> str:
    return f"\033[{code}m{text}\033[0m" if enabled else text


def visible_len(text: str) -> int:
    import re
    return len(re.sub(r"\033\[[0-9;]*m", "", text))


def pad_visible(text: str, width: int) -> str:
    return text + " " * max(0, width - visible_len(text))


def print_cost_box(title: str, amount: float, subtitle: str, *, cyan, green, dim) -> None:
    amount_s = "$" + format(amount, ",.2f")
    line1 = f"{cyan(title)} {green(amount_s)}"
    line2 = dim(subtitle)
    width = max(32, visible_len(line1), visible_len(line2))
    print(dim("╭" + "─" * (width + 2) + "╮"))
    print(dim("│ ") + pad_visible(line1, width) + dim(" │"))
    print(dim("│ ") + pad_visible(line2, width) + dim(" │"))
    print(dim("╰" + "─" * (width + 2) + "╯"))


def print_human(report: dict[str, Any], args: argparse.Namespace) -> None:
    use_color = not args.no_color
    green = lambda s: color(s, "1;32", use_color)
    cyan = lambda s: color(s, "1;36", use_color)
    yellow = lambda s: color(s, "1;33", use_color)
    dim = lambda s: color(s, "2", use_color)
    red = lambda s: color(s, "1;31", use_color)

    if args.source is None and len(report["by_source"]) > 1:
        source_labels = {"hermes": "Hermes", "opencode": "OpenCode", "claude-code": "Claude Code"}
        active_sources = [source_labels.get(s, s) for s in ("hermes", "opencode", "claude-code") if s in report["by_source"]]
        cache_label = "cache→in" if args.no_cache else "cache priced/fallback→in"
        print_cost_box("Total AI spend", report["totals"]["cost_usd"], f"{args.days}d · {' + '.join(active_sources)} · {cache_label}", cyan=cyan, green=green, dim=dim)
        print()

    def section(source: str) -> None:
        items = [i for i in report["by_model"] if i["source"] == source]
        if not items:
            return

        totals = {
            "sessions": sum(int(i["sessions"]) for i in items),
            "calls": sum(int(i["calls"]) for i in items),
            "input_tokens": sum(int(i["input_tokens"]) for i in items),
            "output_tokens": sum(int(i["output_tokens"]) for i in items),
            "cache_read_tokens": sum(int(i["cache_read_tokens"]) for i in items),
            "cache_write_tokens": sum(int(i["cache_write_tokens"]) for i in items),
            "cost_usd": sum(float(i["cost_usd"] or 0.0) for i in items),
        }
        titles = {"hermes": "Hermes PAYG", "opencode": "OpenCode PAYG", "claude-code": "Claude Code PAYG"}
        title = titles.get(source, f"{source} PAYG")
        cache_label = "cache→in" if args.no_cache else "cache priced/fallback→in"
        print_cost_box(title, totals["cost_usd"], f"{args.days}d · {cache_label}", cyan=cyan, green=green, dim=dim)
        total_tokens = totals["input_tokens"] + totals["output_tokens"] + totals["cache_read_tokens"] + totals["cache_write_tokens"]
        call_part = f"  {dim('calls')} {fmt_int(totals['calls'])}" if totals["calls"] else ""
        print(f"{dim('total tokens')} {fmt_tokens(total_tokens)}")
        print(
            f"{dim('tokens')} in {fmt_tokens(totals['input_tokens'])} / "
            f"out {fmt_tokens(totals['output_tokens'])} / "
            f"cache {fmt_tokens(totals['cache_read_tokens'] + totals['cache_write_tokens'])}"
            f"{call_part}  "
            f"{dim('sessions')} {fmt_int(totals['sessions'])}"
        )

        for item in items:
            cost = item["cost_usd"]
            cost_s = red("missing") if cost is None else green(f"${cost:,.2f}")
            model = cyan(item["model"])
            tier = item.get("price_tier")
            priced_as = dim(f"{item['pricing_provider']}:{item['priced_as'] or '?'}" + (f" [{tier}]" if tier else ""))
            print(f"{model}  {cost_s}  {priced_as}")
            if args.verbose:
                print(
                    f"  {dim('tokens')} in {fmt_tokens(item['input_tokens'])}, "
                    f"out {fmt_tokens(item['output_tokens'])}, "
                    f"cache {fmt_tokens(item['cache_read_tokens'] + item['cache_write_tokens'])}; "
                    f"{dim('sessions')} {fmt_int(item['sessions'])}"
                    + (f"; {dim('calls')} {fmt_int(item['calls'])}" if item["calls"] else "")
                )
                if item.get("cost_breakdown_usd"):
                    b = item["cost_breakdown_usd"]
                    print(f"  {dim('cost')} in ${b['input']:,.2f}, out ${b['output']:,.2f}, cache ${b['cache_read'] + b['cache_write']:,.2f}")
                    print(f"  {dim('cache priced as')} read={item.get('cache_read_priced_as')}, write={item.get('cache_write_priced_as')}")
        print()

    section("hermes")
    section("opencode")
    section("claude-code")

    if report["missing_prices"]:
        labels = [f"{m['source']}:{m['billing_provider']}/{m['model']}" for m in report["missing_prices"]]
        print(f"\n{yellow('missing prices')}: " + ", ".join(labels))

    print(dim("\n--verbose for breakdown"))


def graph_start_date(today: date) -> date:
    return min(today - timedelta(days=6), today.replace(day=1))


def collect_daily_rows(args: argparse.Namespace, start: date) -> list[UsageRow]:
    start_ts = local_midnight(start)
    rows: list[UsageRow] = []
    if args.source in (None, "hermes"):
        rows.extend(query_hermes_daily_usage(args.hermes_db.expanduser(), start_ts, args.model_like))
    if args.source in (None, "opencode"):
        rows.extend(query_opencode_daily_usage(args.opencode_db.expanduser(), start_ts, args.model_like))
    if args.source in (None, "claude-code"):
        rows.extend(query_claude_code_daily_usage(args.claude_dir.expanduser(), start_ts, args.model_like))
    return rows


def build_graph_report(rows: list[UsageRow], provider_data: dict[str, Any], no_cache: bool = False, today: date | None = None) -> dict[str, Any]:
    estimated = estimate(rows, provider_data, no_cache=no_cache)
    spend_by_day: dict[str, float] = {}
    for item in estimated["by_model"]:
        day = item.get("day")
        if not isinstance(day, str):
            continue
        spend_by_day.setdefault(day, 0.0)
        if item["cost_usd"] is not None:
            spend_by_day[day] += float(item["cost_usd"])

    if today is None:
        today = date.today()
    periods = {
        "last_7_days": {
            "label": "Last 7 days",
            "start": today - timedelta(days=6),
            "end": today,
        },
        "month_to_date": {
            "label": "Month to date",
            "start": today.replace(day=1),
            "end": today,
        },
    }

    out_periods: dict[str, dict[str, Any]] = {}
    for key, period in periods.items():
        points = [
            {"date": day.isoformat(), "cost_usd": spend_by_day.get(day.isoformat(), 0.0)}
            for day in date_range(period["start"], period["end"])
        ]
        out_periods[key] = {
            "label": period["label"],
            "start": period["start"].isoformat(),
            "end": period["end"].isoformat(),
            "total_cost_usd": sum(float(point["cost_usd"]) for point in points),
            "days": points,
        }

    return {"periods": out_periods, "missing_prices": estimated["missing_prices"]}


def fmt_graph_date(value: str | date) -> str:
    day = date.fromisoformat(value) if isinstance(value, str) else value
    return f"{day.strftime('%b')} {day.day}"


def fmt_graph_range(start: str, end: str) -> str:
    return f"{fmt_graph_date(start)} to {fmt_graph_date(end)}"


def fmt_axis_amount(amount: float) -> str:
    if amount == 0:
        return "$0"
    if amount >= 1000:
        thousands = amount / 1000
        if thousands.is_integer():
            return f"${thousands:.0f}k"
        return f"${thousands:.1f}k"
    if amount >= 1:
        if amount.is_integer():
            return f"${amount:,.0f}"
        return f"${amount:,.1f}"
    return f"${amount:.2f}"


def fmt_exact_amount(amount: float) -> str:
    return f"${amount:,.2f}"


def nice_tick_step(max_cost: float, target_ticks: int = 5) -> float:
    if max_cost <= 0:
        return 1.0

    raw_step = max_cost / target_ticks
    magnitude = 10 ** math.floor(math.log10(raw_step))
    for multiplier in (1, 2, 5, 10):
        step = multiplier * magnitude
        if raw_step <= step:
            return step
    return 10 * magnitude


def print_graph_dates(points: list[dict[str, Any]], label_width: int, col_width: int, dim) -> None:
    dates = [date.fromisoformat(str(point["date"])) for point in points]
    prefix = " " * (label_width + 2)
    if len(dates) <= 10:
        labels = "".join(fmt_graph_date(day).center(col_width) for day in dates)
        print(prefix + dim(labels.rstrip()))
        return

    months: list[str] = []
    last_month: int | None = None
    for day in dates:
        label = day.strftime("%b") if day.month != last_month else ""
        months.append(label.center(col_width))
        last_month = day.month
    days = "".join(str(day.day).center(col_width) for day in dates)
    print(prefix + dim("".join(months).rstrip()))
    print(prefix + dim(days.rstrip()))


def print_graph_exact_values(points: list[dict[str, Any]], label_width: int, col_width: int, green, dim) -> None:
    prefix = " " * (label_width + 2)
    if len(points) <= 10:
        values = []
        for point in points:
            amount = float(point["cost_usd"])
            amount_s = fmt_exact_amount(amount).center(col_width)
            values.append(green(amount_s) if amount > 0 else dim(amount_s))
        print(prefix + "".join(values).rstrip())
        return

    print(prefix + dim("exact spend"))
    line = prefix
    for point in points:
        amount = float(point["cost_usd"])
        amount_s = green(fmt_exact_amount(amount)) if amount > 0 else dim(fmt_exact_amount(amount))
        piece = f"{fmt_graph_date(str(point['date']))} {amount_s}"
        next_line = line + ("" if line == prefix else "  ") + piece
        if line != prefix and visible_len(next_line) > 100:
            print(line.rstrip())
            line = prefix + piece
        else:
            line = next_line
    if line != prefix:
        print(line.rstrip())


def print_vertical_graph(period: dict[str, Any], *, green, cyan, dim) -> None:
    points = period["days"]
    amounts = [float(point["cost_usd"]) for point in points]
    total = float(period["total_cost_usd"])
    range_s = fmt_graph_range(str(period["start"]), str(period["end"]))
    print(f"{cyan(period['label'])} {dim(range_s)} {green(f'${total:,.2f}')}")

    if not points:
        print(dim("No spend recorded."))
        return

    max_cost = max(amounts, default=0.0)
    max_exact_width = max((len(fmt_exact_amount(amount)) for amount in amounts), default=0)
    col_width = max(8, max_exact_width + 1) if len(points) <= 10 else 3
    bar_width = 2 if col_width >= 6 else 1
    step = nice_tick_step(max_cost)
    axis_top = math.ceil(max_cost / step) * step if max_cost > 0 else step
    tick_count = int(round(axis_top / step)) if max_cost > 0 else 1
    label_width = max(len(fmt_axis_amount(axis_top)), len(fmt_axis_amount(0.0)))

    if max_cost <= 0:
        axis = "└" + "─" * (len(points) * col_width + 1)
        print(f"{dim(fmt_axis_amount(0.0).rjust(label_width))} {dim(axis)}")
        print_graph_dates(points, label_width, col_width, dim)
        print_graph_exact_values(points, label_width, col_width, green, dim)
        return

    filled_heights = [min(tick_count, max(1, round(amount / step))) if amount > 0 else 0 for amount in amounts]

    for level in range(tick_count, 0, -1):
        label = fmt_axis_amount(step * level).rjust(label_width)
        cells = []
        for filled in filled_heights:
            if filled >= level:
                cells.append(green(("█" * bar_width).center(col_width)))
            else:
                cells.append(" " * col_width)
        print(f"{dim(label)} {dim('│')} {''.join(cells)}")

    axis = "└" + "─" * (len(points) * col_width + 1)
    print(f"{dim(fmt_axis_amount(0.0).rjust(label_width))} {dim(axis)}")
    print_graph_dates(points, label_width, col_width, dim)
    print_graph_exact_values(points, label_width, col_width, green, dim)


def weekly_periods(period: dict[str, Any]) -> list[dict[str, Any]]:
    chunks = []
    points = period["days"]
    for index, start in enumerate(range(0, len(points), 7), start=1):
        chunk = points[start : start + 7]
        if not chunk:
            continue
        chunks.append({
            "label": f"Week {index}",
            "start": chunk[0]["date"],
            "end": chunk[-1]["date"],
            "total_cost_usd": sum(float(point["cost_usd"]) for point in chunk),
            "days": chunk,
        })
    return chunks


def print_month_graph(period: dict[str, Any], *, green, cyan, dim) -> None:
    total = float(period["total_cost_usd"])
    range_s = fmt_graph_range(str(period["start"]), str(period["end"]))
    print(f"{cyan(period['label'])} {dim(range_s)} {green(f'${total:,.2f}')}")

    for index, week in enumerate(weekly_periods(period)):
        if index:
            print()
        print_vertical_graph(week, green=green, cyan=cyan, dim=dim)


def print_graph(report: dict[str, Any], args: argparse.Namespace) -> None:
    use_color = not args.no_color
    green = lambda s: color(s, "1;32", use_color)
    cyan = lambda s: color(s, "1;36", use_color)
    yellow = lambda s: color(s, "1;33", use_color)
    dim = lambda s: color(s, "2", use_color)

    print_vertical_graph(report["periods"]["last_7_days"], green=green, cyan=cyan, dim=dim)
    print()

    print_month_graph(report["periods"]["month_to_date"], green=green, cyan=cyan, dim=dim)
    print()

    if report["missing_prices"]:
        labels = []
        seen = set()
        for item in report["missing_prices"]:
            label = f"{item['source']}:{item['billing_provider']}/{item['model']}"
            if label in seen:
                continue
            seen.add(label)
            labels.append(label)
        print(f"{yellow('missing prices')}: " + ", ".join(labels))


def parse_args() -> argparse.Namespace:
    p = argparse.ArgumentParser(description="Estimate AI PAYG spend from Hermes, OpenCode, and Claude Code usage.")
    p.add_argument("--days", type=int, default=30, help="Lookback window in days (default: 30)")
    p.add_argument("--hermes-db", type=Path, default=DEFAULT_HERMES_DB, help=f"Hermes state DB path (default: {DEFAULT_HERMES_DB})")
    p.add_argument("--opencode-db", type=Path, default=DEFAULT_OPENCODE_DB, help=f"OpenCode DB path (default: {DEFAULT_OPENCODE_DB})")
    p.add_argument("--claude-dir", type=Path, default=DEFAULT_CLAUDE_DIR, help=f"Claude Code config dir (default: {DEFAULT_CLAUDE_DIR})")
    p.add_argument("--source", choices=["hermes", "opencode", "claude-code"], help="Only include one source")
    p.add_argument("--model-like", help="Filter model names containing this text")
    p.add_argument("--refresh-prices", action="store_true", help="Ignore cached models.dev pricing and fetch fresh data")
    p.add_argument("--no-cache", action="store_true", help="Treat cache tokens as input-priced tokens instead of using cache pricing")
    p.add_argument("--verbose", "-v", action="store_true", help="Show per-model token and cost breakdown")
    p.add_argument("--no-color", action="store_true", help="Disable ANSI colors")
    p.add_argument("--graph", action="store_true", help="Print spend graph for the last 7 calendar days and current month-to-date")
    p.add_argument("--json", action="store_true", help="Print machine-readable JSON")
    return p.parse_args()


def main() -> int:
    args = parse_args()
    provider_data = fetch_json(MODELS_DEV_API, DEFAULT_CACHE, refresh=args.refresh_prices)

    if args.graph:
        today = date.today()
        rows = collect_daily_rows(args, graph_start_date(today))
        report = build_graph_report(rows, provider_data, no_cache=args.no_cache, today=today)
        if args.json:
            print(json.dumps(report, indent=2, sort_keys=True))
        else:
            print_graph(report, args)
        return 0

    rows: list[UsageRow] = []
    if args.source in (None, "hermes"):
        rows.extend(query_hermes_usage(args.hermes_db.expanduser(), args.days, args.model_like))
    if args.source in (None, "opencode"):
        rows.extend(query_opencode_usage(args.opencode_db.expanduser(), args.days, args.model_like))
    if args.source in (None, "claude-code"):
        rows.extend(query_claude_code_usage(args.claude_dir.expanduser(), args.days, args.model_like))
    report = estimate(rows, provider_data, no_cache=args.no_cache)
    if args.json:
        print(json.dumps(report, indent=2, sort_keys=True))
    else:
        print_human(report, args)
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
