#!/usr/bin/env bash
set -euo pipefail

# global variables
readonly PROGRAM_NAME="${0##*/}"
APP_NAME=""
CREATE_GITHUB=0
STYLE="high-end-visual-design"
VALID_STYLES=(
  industrial-brutalist-ui
  minimalist-ui
  high-end-visual-design
)

# ----- print functions -----

# set text colours if supported.
# arguments:
#   $1: boolean indicating if colours are enabled
colours() {
  NC="" BOLD="" RED="" GREEN="" YELLOW="" BLUE="" MAGENTA="" CYAN=""
  if [[ $(tput colors) -ge 8 ]] && [[ $1 == true ]]; then
    NC=$(tput sgr0) BOLD=$(tput bold) # text reset (select graphic representation default)
    RED=$(tput setaf 1) GREEN=$(tput setaf 2) YELLOW=$(tput setaf 3) BLUE=$(tput setaf 4) MAGENTA=$(tput setaf 5) CYAN=$(tput setaf 6)
  fi
}

_info_msg() { printf "%s\n" "${BOLD}${BLUE}info:${NC} $1"; }

_success_msg() { printf "%s\n" "${BOLD}${GREEN}success:${NC} $1"; }

_warning_msg() { printf "%s\n" "${BOLD}${YELLOW}warning:${NC} $1"; }

_error_msg() { printf "%s\n" "${BOLD}${RED}error:${NC} $1" >&2 && exit 1; }

_usage() {
  cat <<EOF
${PROGRAM_NAME} creates a next.js hackathon app with shadcn/ui, ai sdk, opencode, and one ui taste skill.

Run without an app name from an empty folder. If an app name is specified, a folder with that name is created and the app is created there.

${YELLOW}usage:${NC} ${PROGRAM_NAME} ${CYAN}[app-name]${NC} ${CYAN}[options]${NC}

${YELLOW}options:${NC}
  ${GREEN}--style <name>    ${NC} install a supported taste-skill style
  ${GREEN}--github          ${NC} create and push a public github repository
  ${GREEN}-n, --no-colour   ${NC} disable coloured output
  ${GREEN}-h, --help        ${NC} print help information

${YELLOW}valid styles:${NC}
$(printf "  ${GREEN}%s${NC}\n" "${VALID_STYLES[@]}")

${YELLOW}examples:${NC}
  ${PROGRAM_NAME} my-app
  ${PROGRAM_NAME} --style minimalist-ui
  ${PROGRAM_NAME} my-app --github
EOF
}

# ----- helpers -----

_validate_style() {
  local valid_style=0
  local valid_style_name

  for valid_style_name in "${VALID_STYLES[@]}"; do
    if [[ "$STYLE" == "$valid_style_name" ]]; then
      valid_style=1
      break
    fi
  done

  [[ "$valid_style" -eq 1 ]] || { _usage; _error_msg "Invalid style: $STYLE"; }
}

# ----- options -----

parse_args() {
  while [[ $# -gt 0 ]]; do
    case "$1" in
      -h | --help)
        _usage
        exit
        ;;
      -n | --no-colour)
        colours false
        shift
        ;;
      --github)
        CREATE_GITHUB=1
        shift
        ;;
      --style)
        [[ -n "${2:-}" && "$2" != --* ]] || _error_msg "Missing value for --style"
        STYLE="$2"
        shift 2
        ;;
      --*)
        _usage
        _error_msg "Invalid option: $1"
        ;;
      *)
        [[ -z "$APP_NAME" ]] || { _usage; _error_msg "Unexpected argument: $1"; }
        APP_NAME="$1"
        shift
        ;;
    esac
  done
}

# ----- commands -----

ensure_global_skills() {
  if ! npx skills list -g --json | jq -e '.[] | select(.name == "impeccable")' >/dev/null; then
    npx skills add https://github.com/pbakaus/impeccable --skill impeccable --agent opencode -g -y
  fi
}

create_app() {
  if [[ -n "$APP_NAME" ]]; then
    npx create-next-app@latest "$APP_NAME" --yes --src-dir --use-npm
    cd "$APP_NAME"
  else
    npx create-next-app@latest . --yes --src-dir --use-npm
  fi
}

install_project_skills() {
  npx skills add https://github.com/vercel-labs/next-skills --skill next-best-practices --agent opencode -y
  npx skills add shadcn/ui --skill shadcn --agent opencode -y
  npx skills add https://github.com/leonxlnx/taste-skill --skill "$STYLE" --agent opencode -y
}

setup_ui() {
  npx shadcn@latest init --template next --base base --preset nova --yes --no-monorepo --no-rtl
  npx shadcn@latest add button card input textarea label field badge separator dialog dropdown-menu tabs sheet sonner skeleton spinner empty avatar tooltip select checkbox switch table alert progress --yes
}

install_dependencies() {
  npm install ai @ai-sdk/openai @ai-sdk/google zod motion
}

setup_git() {
  git init
  git add .
  git commit -m "Initial hackathon app"

  if [[ "$CREATE_GITHUB" -eq 1 ]]; then
    gh repo create "${APP_NAME:-$(basename "$PWD")}" --public --source . --push
  fi
}

print_next_steps() {
  _success_msg "Created app at $PWD"
  _info_msg "Next: cd '$PWD' && npm run dev"
}

# ----- main -----

main() {
  colours true
  parse_args "$@"
  _validate_style
  ensure_global_skills
  create_app
  install_project_skills
  setup_ui
  install_dependencies
  setup_git
  print_next_steps
}

main "$@"
