#!/bin/bash

INPUT="$1"
RADIUS_PERCENT=${2:-15}
OUTPUT="${INPUT%.*}_rounded.png"
MASK="/tmp/mask.png"

# get dimensions
read W H < <(identify -format "%w %h" "$INPUT")

if [ "$W" -lt "$H" ]; then SHORTER_SIDE=$W; else SHORTER_SIDE=$H; fi

# calc radius in pixels. Bash only performs integer math, which is fine
RADIUS=$((SHORTER_SIDE * RADIUS_PERCENT / 100))
echo "Radius (in pixels): $RADIUS"

# works on png since it uses alpha channel (transparent background)
# https://stackoverflow.com/questions/718314/rounding-corners-of-pictures-with-imagemagick
# create rounded corner mask
convert -size ${W}x${H} xc:none \
  -draw "roundrectangle 0,0,$((W-1)),$((H-1)),$RADIUS,$RADIUS" "$MASK"

# apply mask
convert "$INPUT" -matte "$MASK" -compose DstIn -composite "$OUTPUT"

rm "$MASK"
echo "Saved to $OUTPUT"
