{
  "[c]": { "editor.defaultFormatter": "llvm-vs-code-extensions.vscode-clangd" },
  "[cpp]": { "editor.defaultFormatter": "llvm-vs-code-extensions.vscode-clangd" },
  "[css]": { "editor.defaultFormatter": "vscode.css-language-features" },
  "[go]": { "editor.defaultFormatter": "golang.go" },
  "[html]": { "editor.defaultFormatter": "vscode.html-language-features" },
  "[javascript]": { "editor.defaultFormatter": "oxc.oxc-vscode" },
  "[json]": { "editor.defaultFormatter": "vscode.json-language-features" },
  "[jsonc]": { "editor.defaultFormatter": "vscode.json-language-features" },
  "[markdown]": { "editor.defaultFormatter": "jolars.panache" },
  "[python]": { "editor.defaultFormatter": "charliermarsh.ruff" },
  "[rust]": { "editor.defaultFormatter": "rust-lang.rust-analyzer" },
  "[typescript]": { "editor.defaultFormatter": "oxc.oxc-vscode" },
  "[yaml]": { "editor.defaultFormatter": "redhat.vscode-yaml" },
  "editor.accessibilitySupport": "off",
  "editor.cursorBlinking": "expand",
  "editor.fontFamily": "'GeistMono Nerd Font', monospace",
  "editor.fontLigatures": true,
  "editor.fontSize": 16,
  "editor.inlayHints.enabled": "offUnlessPressed",
  "editor.minimap.enabled": false,
  "editor.multiCursorModifier": "ctrlCmd",
  "editor.tabCompletion": "on",
  "editor.wordWrap": "on",
  "explorer.confirmDelete": false,
  "explorer.confirmDragAndDrop": false,
  "files.exclude": { "**/.DS_Store": false, "**/.git": false },
  "files.insertFinalNewline": true,
  "files.trimTrailingWhitespace": true,
  "search.exclude": { "**/.git": true },
  "telemetry.feedback.enabled": false,
  "telemetry.telemetryLevel": "off",
  "window.menuBarVisibility": "toggle",
  "window.newWindowProfile": "Default",
  "workbench.colorTheme": "Catppuccin Mocha",
  "workbench.settings.enableNaturalLanguageSearch": false,
  "workbench.startupEditor": "none",
  "zenMode.fullScreen": false,
  // Extensions
  "clangd.fallbackFlags": [ "-std=c++20" ],
  "cSpell.diagnosticLevel": "Hint",
  "git.blame.editorDecoration.enabled": true,
  "git.enableCommitSigning": true,
  "go.survey.prompt": false,
  "js/ts.suggest.completeFunctionCalls": true,
  "js/ts.updateImportsOnFileMove.enabled": "always",
  "markdown.extension.tableFormatter.enabled": false,
  "python.analysis.completeFunctionParens": true,
  "python.analysis.typeCheckingMode": "standard",
  "rust-analyzer.check.command": "clippy",
  "rust-analyzer.imports.granularity.group": "module",
  "shellcheck.run": "onSave"
}
