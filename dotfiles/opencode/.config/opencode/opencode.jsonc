{
  "$schema": "https://opencode.ai/config.json",
  "plugin": [],
  "provider": {},
  "mcp": {
    "a11y-accessibility": {
      "type": "local",
      "command": ["npx", "-y", "a11y-mcp-server"],
      "enabled": false
    },
    "citra": {
      "type": "local",
      "command": ["npx", "@sylphx/citra"],
      "enabled": false
    },
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "headers": { "CONTEXT7_API_KEY": "{env:CONTEXT7_API_KEY}" },
      "enabled": true
    },
    "searchcode": {
      "type": "remote",
      "url": "https://api.searchcode.com/v1/mcp",
      "enabled": false
    }
  }
}
